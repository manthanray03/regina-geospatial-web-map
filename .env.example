# Copy this file to .env and change the values if needed.

# PostgreSQL / PostGIS
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=regina_gis
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# Full path to ogr2ogr if it is not on your PATH, for example:
# OGR2OGR_PATH=C:\Program Files\QGIS 3.40.0\bin\ogr2ogr.exe
OGR2OGR_PATH=ogr2ogr

# Columns in the City's park amenities shapefile (the "name" column is the park name)
NAME_COLUMN=detailtype
TYPE_COLUMN=
PARK_COLUMN=name

# Only if the shapefile has no .prj file
SOURCE_SRS=

# ArcGIS Online (only for arcgis_online/publish_to_arcgis.py)
ARCGIS_URL=https://www.arcgis.com
ARCGIS_USERNAME=
ARCGIS_PASSWORD=
